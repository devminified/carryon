# Supabase local dev (supabase/config.toml) — a GitHub OAuth App's
# credentials, used by the `[auth.external.github]` provider. See
# .claude/rules/auth.md for how to create the OAuth App and where its
# callback URL needs to point.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

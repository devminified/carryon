# Edge Function secrets beyond what Supabase provides automatically
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY — every
# function gets those for free). Copy this to supabase/functions/.env
# for local dev (gitignored); for staging/production use
# `supabase secrets set NAME=value` instead, never commit real values.

# sync-github-teams (CO-303) — see .claude/rules/auth.md's "GitHub App
# setup" for how to create the App and get these three values.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# The shared secret the sync-github-teams cron job (pg_cron + pg_net)
# presents as its own x-cron-secret header — sync-github-teams checks
# this instead of a caller JWT (Kong's JWT gate is disabled for this
# one function, config.toml). Must match the value stored in Vault as
# 'sync_github_teams_cron_secret' (see the migration's own comment for
# the one-time `vault.update_secret` step this requires).
CRON_SECRET=

# rescan (CO-306) — same shape as CRON_SECRET above, its own secret:
# the nightly secret-rescan cron job's x-cron-secret header. Must
# match Vault's 'rescan_cron_secret' (see
# supabase/migrations/20261108050000_add_secret_rescan.sql's own
# comment for the one-time vault.update_secret step).
RESCAN_CRON_SECRET=

# purge-expired-sessions (CO-307) — same shape again, its own secret.
# Must match Vault's 'purge_expired_sessions_cron_secret' (see
# supabase/migrations/20261108060000_add_retention_and_deletion.sql's
# own comment for the one-time vault.update_secret step).
PURGE_CRON_SECRET=

# summarize-session (CO-407) — same shape again, its own secret, for
# its 30-minute live-session sweep only (end-session's own trigger
# never goes through this header at all — see that function's and
# summarize-session's own comments). Must match Vault's
# 'summarize_session_cron_secret' (see
# supabase/migrations/20261109010000_add_ai_summary_job.sql's own
# comment for the one-time vault.update_secret step).
SUMMARIZE_CRON_SECRET=

# summarize-session (CO-407) and end-session (CO-111/CO-407) both need
# this to call the real Anthropic API (Claude Haiku) — see
# .claude/rules/edge-functions.md's "summarize-session and the
# Anthropic API" section. Without it, end-session logs a warning and
# skips a session's final summary, and the cron sweep 500s outright
# (there's nothing useful it can do without a key).
ANTHROPIC_API_KEY=

# send-daily-digest (CO-409) — same shape again, its own secret, for
# its once-daily cron sweep. Must match Vault's
# 'send_daily_digest_cron_secret' (see
# supabase/migrations/20261109030000_add_slack_notifications.sql's
# own comment for the one-time vault.update_secret step).
DIGEST_CRON_SECRET=

# Used by _shared/slack.ts (CO-409) to build a session's web-viewer
# link in every Slack message (blocked-session alert, secret-rescan
# hit, the daily digest) — e.g. https://app.carryon.example. Without
# it, every message still sends, just with no link, degrading
# gracefully rather than failing (see buildSessionUrl's own comment).
WEB_APP_URL=

# record-compat-run (CO-503) — the shared secret the nightly Claude
# Code compatibility GitHub Actions workflow presents as its own
# x-ci-secret header. Unlike every CRON_SECRET above, this one has no
# Supabase Vault counterpart to keep in sync (there's no pg_cron job
# involved at all — see record-compat-run's own doc comment): just set
# this value directly as a GitHub Actions repository secret
# (COMPAT_CI_SECRET) with the exact same value.
COMPAT_CI_SECRET=

# record-compat-run (CO-503) — Carryon's own team Slack channel for a
# failing nightly compatibility run, deliberately separate from any
# project's own project_notification_settings webhook (this is about
# Carryon's own build, not a client project's sessions). Optional —
# a failing run is still recorded either way, just without a Slack
# post if this is unset.
COMPAT_CI_SLACK_WEBHOOK_URL=

# check-observability-alerts (CO-504) — the fleet-wide observability
# sweep's own shared secret (every 30 minutes). Must match Vault's
# 'check_observability_alerts_cron_secret' (see
# supabase/migrations/20261112000000_add_observability.sql's own
# comment for the one-time vault.update_secret step).
CHECK_ALERTS_CRON_SECRET=

# check-observability-alerts (CO-504) — Carryon's own team Slack
# channel for a stale-agent/lag/error-rate/storage-growth alert,
# same "dedicated team-wide secret, not a per-project webhook" shape
# as COMPAT_CI_SLACK_WEBHOOK_URL above. Optional — every alert still
# transitions and gets recorded either way, just without a Slack
# post if this is unset.
OBSERVABILITY_SLACK_WEBHOOK_URL=

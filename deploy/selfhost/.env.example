# CO-506: self-hosted stack configuration. Copy to .env next to
# docker-compose.yml (`cp .env.example .env`) and fill in every value
# below before `docker compose up -d` — see README.md's quick start.
# Never commit a real .env; this file only ever holds placeholders.

### Postgres ###
# A long random value — e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

### Auth (JWT) ###
# A long random value, at least 32 characters — e.g. `openssl rand
# -base64 32`. Signs every Supabase Auth session and every API key
# below; losing or rotating this logs every user out and invalidates
# ANON_KEY/SERVICE_ROLE_KEY (they're both JWTs signed with it — see
# README.md's "Generating your keys" step for how to mint them from
# this same secret).
JWT_SECRET=

# The two Supabase API keys every client (web app, Carryon's own CLI
# and Edge Functions) presents to Kong — both are JWTs signed with
# JWT_SECRET above, one with role "anon", one with role
# "service_role". README.md's "Generating your keys" step shows the
# exact one-line command to mint both from JWT_SECRET.
ANON_KEY=
SERVICE_ROLE_KEY=

### URLs ###
# Where a browser/the carryon CLI reaches this stack's own Kong
# gateway — e.g. https://carryon.internal.example.com, or
# http://127.0.0.1:8000 for a local trial.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
KONG_HTTP_PORT=8000

# Where the web app itself is reached — used only for Auth's own
# redirect allowlist (GOTRUE_SITE_URL/GOTRUE_URI_ALLOW_LIST) and in
# Slack message links (WEB_APP_URL, below).
WEB_APP_URL=http://127.0.0.1:3000
WEB_PORT=3000

### GitHub OAuth App (sign-in) — see .claude/rules/auth.md's "GitHub
### OAuth App setup" for how to create one; its callback URL is
### {SUPABASE_PUBLIC_URL}/auth/v1/callback. Leave GITHUB_OAUTH_ENABLED
### at its default (false) until you've created one — Auth starts
### fine either way; sign-in just isn't usable yet.
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

### GitHub Enterprise Server — leave both unset for github.com.
### GITHUB_ENTERPRISE_URL is GoTrue's own OAuth authorize/token host;
### GITHUB_ENTERPRISE_API_URL is the REST API host sync-github-teams
### calls (normally "<GITHUB_ENTERPRISE_URL>/api/v3" for a real GHES
### instance) — see README.md's own "GitHub Enterprise Server"
### section for the one real limitation this has (GoTrue's own
### user/email lookup stays hardcoded to api.github.com even when
### GITHUB_ENTERPRISE_URL is set, which only matters if your GHES
### instance doesn't use the standard OAuth app endpoints).
GITHUB_ENTERPRISE_URL=
GITHUB_ENTERPRISE_API_URL=

### GitHub App (team sync, CO-303) — same as auth.md's own section,
### optional: a project with none of its team_viewer/resumer/admin
### columns set stays 100% manually managed, no GitHub App required.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

### AI summaries — optional. Leave both unset/false to run with AI
### summaries off entirely (the backend skips summarization
### end-to-end, and the web app hides every AI-related tile/button —
### see ai-enabled.ts). Set AI_ENABLED=true and provide a real key to
### turn summaries on.
AI_ENABLED=false
ANTHROPIC_API_KEY=

### Storage — defaults to the bundled SeaweedFS service (see
### docker-compose.yml's own header comment for why this isn't
### MinIO). STORAGE_S3_ACCESS_KEY/SECRET_KEY are credentials you
### choose for this stack's own internal use only (SeaweedFS's S3
### gateway, not a real AWS account) — e.g. `openssl rand -hex 20`
### for each. Point at a real S3 bucket instead by overriding these
### (see docker-compose.yml's `storage` service) and skipping the
### seaweedfs/storage-setup services in an override file.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=carryon-sessions
STORAGE_S3_REGION=us-east-1

### Realtime (internal secrets — random values, never shared outside
### this stack).
REALTIME_DB_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

### Cron secrets — one shared value per scheduled job, matching each
### Vault secret the matching migration documents (database-rls.md's
### "Scheduled jobs" section) — e.g. `openssl rand -hex 24` each.
CRON_SECRET=
RESCAN_CRON_SECRET=
PURGE_CRON_SECRET=
SUMMARIZE_CRON_SECRET=
DIGEST_CRON_SECRET=
CHECK_ALERTS_CRON_SECRET=

### Optional Slack webhooks — see .claude/rules/notifications.md.
COMPAT_CI_SECRET=
COMPAT_CI_SLACK_WEBHOOK_URL=
OBSERVABILITY_SLACK_WEBHOOK_URL=
